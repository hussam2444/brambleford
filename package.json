{
  "name": "brambleford",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim": "tsx scripts/sim.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run sim && npm run test:rules && npm run test:server && npm run test:google",
    "test:rules": "tsx scripts/rules-test.ts",
    "build:contract": "npm --prefix contract run build",
    "test:contract": "npm --prefix contract test",
    "sandbox": "npm --prefix contract run sandbox",
    "deploy": "tsx scripts/deploy.ts",
    "dev:testnet": "vite --mode testnet",
    "test:api": "tsx scripts/e2e-api.ts",
    "test:server": "tsx scripts/server-test.ts",
    "test:google": "tsx scripts/test-google.ts",
    "play:order": "tsx scripts/play-order.ts",
    "setup:contract": "npm --prefix contract install",
    "host": "tsx scripts/host.ts"
  },
  "dependencies": {
    "near-api-js": "^7.5.3",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.6"
  }
}
