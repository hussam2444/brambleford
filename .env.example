# Copy to .env.local, or let `npm run sandbox` / `npm run deploy` write the real file for you.
# With none of these set, the game runs a private practice town in the browser tab.

# Read by the game in the browser
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_NEAR_CONTRACT_ID=your-town.testnet

# Read by the back end only (server/near.ts). Never expose these to the browser.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=your-town.testnet
NEAR_RELAYER_ID=your-town-folk.testnet
NEAR_RELAYER_KEY=ed25519:...

# Each shopkeeper's own key, so it can sign its own change of plan (written by the deploy script)
NEAR_KEY_BLACKSMITH=ed25519:...
NEAR_KEY_BAKER=ed25519:...
NEAR_KEY_FISHMONGER=ed25519:...
NEAR_KEY_CARPENTER=ed25519:...

# Optional: with a key, a model on NEAR AI Cloud decides each shopkeeper's plan, inside hard limits (https://cloud.near.ai).
# Without a key, or whenever the model cannot be used, fixed rules decide instead.
NEAR_AI_API_KEY=
# Optional: which model to ask. Left empty, it is deepseek-ai/DeepSeek-V3.1.
NEAR_AI_MODEL=
