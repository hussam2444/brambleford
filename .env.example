# Copy to .env.local, or let `npm run sandbox` / `npm run deploy` write the real file for you.
# With none of these set, the game runs a private practice town in the browser tab.

# Read by the game in the browser
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_NEAR_CONTRACT_ID=your-town.testnet

# Read by the back end only (server/near.ts). Never expose these to the browser.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_CONTRACT_ID=your-town.testnet
NEAR_RELAYER_ID=your-town-folk.testnet
NEAR_RELAYER_KEY=ed25519:...

# Each shopkeeper's own key, so it can sign its own change of plan (written by the deploy script)
NEAR_KEY_BLACKSMITH=ed25519:...
NEAR_KEY_BAKER=ed25519:...
NEAR_KEY_FISHMONGER=ed25519:...
NEAR_KEY_CARPENTER=ed25519:...

# Optional: lets shopkeepers put their plans in their own words (https://cloud.near.ai)
NEAR_AI_API_KEY=

# Optional: "Sign in with Google", so a player keeps their character on any device.
# Leave both lines empty and the game shows nothing about it: everyone plays as a guest.
#
# To get a client id:
#   1. In the Google Cloud console (https://console.cloud.google.com), pick or make a project.
#   2. APIs & Services > Credentials > Create credentials > OAuth client ID, of type
#      "Web application". The console first asks for a consent screen: an app name and
#      your email are enough. While that screen is in "Testing" only the test users you
#      list can sign in, so press "Publish app" to let anyone in.
#   3. Under "Authorised JavaScript origins" add https://brambleford.vercel.app and
#      http://localhost:5183 (for local testing Google also wants plain http://localhost).
#      No redirect address and no client secret are needed.
#   4. Put the client id (it ends in .apps.googleusercontent.com) in both lines below.
#      They must be the same: the browser uses the first, the back end checks the second.
# For the hosted game, add the two lines to .env.testnet and run `npm run host`.
# `npm run deploy` rewrites .env.testnet, so add them again if you deploy again.
#
# What this costs in trust: the account made for a signed-in player carries a second key,
# with full access, held by the relayer (NEAR_RELAYER_KEY). That key is what lets the
# relayer add another browser's key when the same person signs in on a new device. It also
# means whoever holds NEAR_RELAYER_KEY can act for those players. Keep that key safe, and
# keep it the same: accounts made under an old key could not be given new devices.
# Guest accounts carry no such key.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
